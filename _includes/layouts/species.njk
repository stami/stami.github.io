---
layout: layouts/base.njk
---

{% include "photo-gallery-assets.njk" %}
{% set photos = collections.photos | speciesPhotos(page.fileSlug) %}

<article>
	<h1>{{ title }}</h1>
	<p class="text-slate-500 dark:text-slate-400"><i>{{ scientificName }}</i></p>
	{{ content | safe }}

	<div class="photo-gallery mt-6 columns-2 gap-2">
		{%- for photo in photos %}
		<figure class="mb-2 break-inside-avoid">
			{% galleryImage photo.image, photo.alt, photo.caption, photo.inputPath %}
			<figcaption class="mt-1 text-sm">
				{%- if photo.caption %}{{ photo.caption | escape }} · {% endif -%}
				<a href="{{ photo.postUrl }}">{{ photo.postTitle }}</a>
			</figcaption>
		</figure>
		{%- endfor %}
	</div>
</article>
