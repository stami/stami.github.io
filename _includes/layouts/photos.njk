---
layout: layouts/base.njk
---

{% include "photo-gallery-assets.njk" %}

<article>
	<h1 class="mb-2">{{ title }}</h1>
	<time class="text-slate-500 dark:text-slate-400" datetime="{{ page.date | htmlDateString }}">{{ page.date | readableDate }}</time>
	{{ content | safe }}

	<div class="photo-gallery mt-6 columns-2 gap-2">
		{%- for photo in photos %}
		<figure class="mb-2 break-inside-avoid">
			{% galleryImage photo.image, photo.alt, photo.caption %}
			{%- if photo.caption %}<figcaption class="mt-1 text-sm">{{ photo.caption | escape }}</figcaption>{% endif %}
		</figure>
		{%- endfor %}
	</div>
</article>
