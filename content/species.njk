---
layout: layouts/home.njk
title: Species
---
<h1>Species</h1>

<ol class="mt-6 flex flex-col gap-4">
{%- for species in collections.species | sort(false, false, "data.title") %}
	{% set photos = collections.photos | speciesPhotos(species.page.fileSlug) %}
	{% set albumCount = photos | photoAlbumCount %}
	<li>
		<a href="{{ species.url }}" class="text-xl text-slate-700 dark:text-slate-200 hover:text-slate-500 dark:hover:text-slate-400 hover:underline underline-offset-4 decoration-4 hover:decoration-slate-400 dark:hover:decoration-slate-500">{{ species.data.title }}</a>
		<div class="text-sm text-slate-500 dark:text-slate-400"><i>{{ species.data.scientificName }}</i> · {{ photos.length }} photo{% if photos.length != 1 %}s{% endif %} in {{ albumCount }} album{% if albumCount != 1 %}s{% endif %}</div>
	</li>
{%- endfor %}
</ol>
