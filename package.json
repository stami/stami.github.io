{
  "name": "oaken-11ty",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:11ty": "npx @11ty/eleventy",
    "build:css": "npx tailwindcss -i public/css/_tailwind.css -o public/css/generated.css --minify",
    "build:cms": "yarn build:css && rm -rf _netlify && mkdir -p _netlify/admin && cp -R public/admin/. _netlify/admin/ && cp public/css/generated.css _netlify/admin/preview-tailwind.css && cp public/css/index.css _netlify/admin/preview-base.css && cp node_modules/prism-themes/themes/prism-one-dark.css _netlify/admin/preview-code.css",
    "build": "yarn clean && yarn build:css && yarn build:11ty",
    "validate:css": "npx tailwindcss -i public/css/_tailwind.css -o .validation/generated.css --minify",
    "validate:11ty": "ELEVENTY_GENERATED_CSS=./.validation/generated.css npx @11ty/eleventy --output=.validation/site",
    "validate": "rm -rf .validation && mkdir -p .validation && yarn validate:css && yarn validate:11ty && rm -rf .validation",
    "dev:css": "tailwindcss -i public/css/_tailwind.css -o public/css/generated.css --watch",
    "dev:11ty": "npx @11ty/eleventy --serve --incremental",
    "start": "yarn clean && concurrently \"yarn dev:11ty\" \"yarn dev:css\"",
    "clean": "rm -rf _site public/css/generated.css"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-img": "^7.0.0",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-bundle": "3.0.7",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "luxon": "^3.7.2",
    "markdown-it-anchor": "^9.2.1",
    "photoswipe": "^5.4.4",
    "postcss": "^8.5.26",
    "prism-themes": "^1.9.0",
    "tailwindcss": "^3.4.19"
  }
}
